---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.weight - b.data.weight);
---
<Base title="Projects" description="Things I've built, broken, and learned from.">
  <div class="container" style="padding-top:4rem; padding-bottom:5rem;">
    <h1 style="font-size:2rem; font-weight:700; letter-spacing:-0.03em; margin-bottom:0.5rem;">Projects</h1>
    <p style="color:var(--muted); margin-bottom:3rem;">
      Things I've built, broken, and learned from.
    </p>

    <div class="project-grid">
      {projects.map(project => (
        <a href={`/projects/${project.id}/`} class="project-card">
          <div class="project-card-top">
            <span class="project-card-title">{project.data.title}</span>
            <span class={`status status-${project.data.status.replace(' ', '-')}`}>
              {project.data.status}
            </span>
          </div>
          <p class="project-card-desc">{project.data.description}</p>
          {project.data.tags.length > 0 && (
            <div class="tags">
              {project.data.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          )}
          <div class="project-card-links">
            <span class="project-card-link">Read more →</span>
            {project.data.github && <span class="project-card-link">GitHub ↗</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
