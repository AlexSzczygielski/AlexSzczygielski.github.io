---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Alex Szczygielski',
  description = 'Backend, DevOps, and cybersecurity — projects and write-ups.',
} = Astro.props;

const fullTitle = title === 'Alex Szczygielski' ? title : `${title} — Alex Szczygielski`;

const nav = [
  { label: 'Journal',   href: '/posts/' },
  { label: 'Projects',  href: '/projects/' },
  { label: 'About',     href: '/about/' },
  { label: 'GitHub',    href: 'https://github.com/AlexSzczygielski',   ext: true },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/in/aleksander-szczygielski-505821367/', ext: true },
];

const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alex Szczygielski" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
<div class="site-wrapper">

  <header class="nav">
    <div class="container">
      <nav class="nav-inner" aria-label="Main navigation">
        <a href="/" class="nav-logo">Alex Szczygielski</a>
        <ul class="nav-links">
          {nav.map(({ label, href, ext }) => (
            <li>
              <a
                href={href}
                class={ext ? 'nav-ext' : ''}
                aria-current={!ext && current.startsWith(href) ? 'page' : undefined}
                {...(ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} Alex Szczygielski</span>
        <div class="footer-links">
          <a href="https://github.com/AlexSzczygielski" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/aleksander-szczygielski-505821367/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="/posts/">Journal</a>
        </div>
      </div>
    </div>
  </footer>

</div>
</body>
</html>
