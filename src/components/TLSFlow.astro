---
interface Step {
  num: string;
  name: string;
  sub: string;
  edge?: string | null;
  hi?: boolean;
}
interface Flow {
  label: string;
  steps: Step[];
}
interface Props {
  flows: Flow[];
}
const { flows } = Astro.props;
---
<div class="tls-wrap">
  {flows.map((flow, fi) => (
    <div class="tls-section">
      {fi > 0 && <hr class="tls-divider"/>}
      <p class="tls-label">{flow.label}</p>
      <div class="stepper">
        {flow.steps.map(step => (
          <>
            {step.edge && (
              <div class="connector">
                <span class="conn-label">{step.edge}</span>
                <div class="conn-line"></div>
              </div>
            )}
            <div class:list={['step', step.hi && 'step--hi']}>
              <div class="step-circle">{step.num}</div>
              <p class="step-name">{step.name}</p>
              <p class="step-sub">{step.sub}</p>
            </div>
          </>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .tls-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .tls-label {
    font-size: 10px;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.25rem !important;
  }

  .tls-divider {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 1.5rem 0 1.25rem;
  }

  .stepper {
    display: flex;
    align-items: flex-start;
  }

  /* Step */
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    width: 90px;
    text-align: center;
  }

  .step-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .step--hi .step-circle {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--tag-bg);
  }

  .step-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    margin: 0 !important;
    line-height: 1.3;
  }

  .step--hi .step-name {
    color: var(--accent);
  }

  .step-sub {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--muted);
    margin: 0 !important;
    line-height: 1.3;
  }

  /* Connector */
  .connector {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 17px = half of 36px circle, centers the line on the circle */
    padding-top: 17px;
    gap: 3px;
    min-width: 0;
  }

  .conn-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
    line-height: 1;
  }

  .conn-line {
    width: 100%;
    height: 1px;
    background: var(--border);
    position: relative;
  }

  .conn-line::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -4px;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--border);
  }

  @media (max-width: 540px) {
    .stepper {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    .step {
      flex-direction: row;
      width: auto;
      text-align: left;
      gap: 0.75rem;
    }
    .connector {
      flex-direction: row;
      padding-top: 0;
      padding-left: 17px;
      height: 32px;
      align-items: center;
      gap: 6px;
    }
    .conn-line {
      width: 1px;
      height: 100%;
      background: var(--border);
    }
    .conn-line::after { display: none; }
  }
</style>
